DISCORD_TOKEN=
MONGODB_URI=mongodb://localhost:27017/text_extractor_bot
MONGODB_DB=text_extractor_bot
OWNER_ID=656783724662226963
TEMP_API_URL=
GDRIVE_API_KEY=
BASE_QWEN_URL=https://chat.qwen.ai/api/v2
EMOJI_THEME=gold
SYNC_APPLICATION_EMOJIS=true

# ---- الأداء والاستقرار ----
# عدد الصور المعالجة في نفس اللحظة (الموازاة)
EXTRACTION_CONCURRENCY=2
# الحد الأقصى للصور في الرسالة الواحدة
MAX_IMAGES_PER_REQUEST=10
# محاولات كل صورة قبل إنقاذها بالتقسيم الذكي
MAX_RETRY_PER_IMAGE=3

# ---- التقسيم الذكي للصفحات الشريطية الطويلة ----
# سياسة ثابتة: حتى 16000 بكسل كاملة، وفوقها ثلاثة أجزاء معًا في طلب واحد.
# لا تُستعمل إعدادات ارتفاع المقاطع القديمة أو إعادة تقسيمها.
TILE_OVERLAP=320

# ---- المراجعة الآلية بعد الترجمة ----
# ترجمة أي مقاطع أجنبية متبقية في النص المترجم (إنجليزي/كوري/صيني) وتلصيقها مكانها،
# وحروف التصنيف (A/S/SS/C) تبقى كما هي — نص الاستخراج الخام لا يُمس إطلاقًا
FOREIGN_REVIEW_ENABLED=1

# ---- الترجمة المجزأة للفصول الطويلة ----
# سقف الأسطر غير الفارغة لكل مجموعة ترجمة (المسار النصي)
TRANSLATION_CHUNK_LINES=60
# سقف الأحرف لكل مجموعة ترجمة (المسار النصي)
TRANSLATION_CHUNK_CHARS=9000

# ---- الترجمة من الصور نفسها ----
# الواجهة تقبل 5 صور في الطلب الواحد — الصفحات/الأجزاء تُرسل بدفعات مرتبة بهذا الحد
QWEN_IMAGES_PER_REQUEST=5

# ---- مزود الاستخراج والترجمة ----
# Initial settings only. Owner-only /zx settings saved in MongoDB take priority.
# qwen | gemini | gpt | dark | deepseek
AI_PROVIDER=qwen

# Gemini: complete Google browser Cookie header, for account /u/1 as in the source.
GEMINI_COOKIE_HEADER=
# Alternative: a mounted file containing only that Cookie header.
GEMINI_COOKIE_FILE=

# GPT: ChatGPT account access token, not an OpenAI API key.
CHATGPT_ACCESS_TOKEN=
CHATGPT_MODEL=auto

# Additional services (secrets stay outside Git).
DEEPSEEK_TOKEN=
DEEPSEEK_MODEL=
# Set to the HTTPS origin of this bot service for temporary OCR attachment links.
PUBLIC_FILE_BASE_URL=
PORT=8080
